# Images (folder-based organization)
# Keep folder structure but ignore all image files
images/**/*.png
images/**/*.jpg
images/**/*.jpeg
images/**/*.gif
images/**/*.webp
images/**/*.bmp
images/**/*.svg
images/**/*.avif

# Ignore all folders except default
images/*
!images/default/
!images/README.txt

# Keep default folder but ignore images inside it
images/default/*
!images/default/.gitkeep
